# .env.example -> .env sifatida nusxalang va qiymatlarni to'ldiring

# --- Ma'lumotlar bazasi ---
# SQLite (default, fayl loyiha ildizida) yoki PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_teacher_db
DATABASE_URL=sqlite:///./data.db

# --- LLM provayder ---
# LLM_PROVIDER=auto  -> OPENAI_API_KEY bo'lsa OpenAI, bo'lmasa oflayn (mock) evristika
# LLM_PROVIDER=mock  -> har doim oflayn
# LLM_PROVIDER=openai
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI-ga mos boshqa serverlar: Groq, OpenRouter, Ollama (http://localhost:11434/v1), Azure gateway ...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60

# --- Xavfsizlik ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# true bo'lsa barcha /api so'rovlar uchun JWT token shart; false (demo) bo'lsa tokensiz so'rovlar "demo" o'qituvchi sifatida ishlaydi
AUTH_REQUIRED=false
# Demo foydalanuvchilarni yaratish (teacher/teacher123, admin/admin123, dekan/dekan123)
DEMO_USERS=true

# --- Baholash shkalasi (100 -> 5 ballik) ---
GRADE_5_MIN=86
GRADE_4_MIN=71
GRADE_3_MIN=56

# --- Analitika ---
MINUTES_PER_MANUAL_CHECK=12
PLAGIARISM_FLAG_THRESHOLD=0.4
AI_FLAG_THRESHOLD=0.6
SIMILARITY_FLAG_THRESHOLD=0.6

# --- Tariflar / to'lov (config/pricing.json) ---
# Tizimga kirmagan (demo) foydalanuvchi tarifi: free | pro | kafedra | universitet
DEFAULT_PLAN=universitet
# Limitlar va funksiya cheklovlarini qo'llash
PLAN_ENFORCEMENT=true
# true: obuna egasi "to'lov qildim" deb o'zi tasdiqlaydi (demo); false: faqat admin
DEMO_PAYMENTS=true

# --- Fayllar ---
EXPORT_DIR=./exports
HEMIS_TEMPLATE_PATH=./config/hemis_template.json
MAX_UPLOAD_MB=10
MAX_BATCH_FILES=100

# --- Frontend ---
BACKEND_URL=http://localhost:8000
